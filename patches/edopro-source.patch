+
+/* [web] 브라우저에서 방 목록을 가져온다.
+   - curl 은 스텁이라 사용할 수 없다
+   - emscripten_fetch 의 동기 모드는 responseType(arraybuffer) 때문에 XHR 예외로 **null 을 돌려준다**
+     -> 동기 XHR + charset=x-user-defined 로 받아 MEMFS 에 쓰고, C++ 에서 읽는다 (카드 이미지와 같은 방식)
+   - CORS 회피를 위해 URL 의 경로만 사용해 현재 페이지 오리진에서 요청한다 */
+static bool WebHttpGetPath(const std::string& url, std::string& out) {
+	auto pos = url.find("/api/");
+	std::string path = (pos == std::string::npos) ? url : url.substr(pos);
+	const int len = EM_ASM_INT({
+		try {
+			var p = UTF8ToString($0);
+			var xhr = new XMLHttpRequest();
+			xhr.open('GET', p, false);
+			xhr.overrideMimeType('text/plain; charset=x-user-defined');
+			xhr.send(null);
+			if (xhr.status !== 200) {
+				console.log('[lobby] GET ' + p + ' status=' + xhr.status);
+				return -1;
+			}
+			var txt = xhr.responseText || '';
+			var arr = new Uint8Array(txt.length);
+			for (var i = 0; i < txt.length; i++) arr[i] = txt.charCodeAt(i) & 0xff;
+			Module.FS.writeFile('/tmp/getrooms.json', arr);
+			console.log('[lobby] GET ' + p + ' ok ' + arr.length + 'B');
+			return arr.length;
+		} catch (e) {
+			console.log('[lobby] err ' + e);
+			return -2;
+		}
+	}, path.c_str());
+	if (len <= 0)
+		return false;
+	std::ifstream in("/tmp/getrooms.json", std::ios::binary);
+	if (!in)
+		return false;
+	out.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+	return !out.empty();
+}
+#endif
