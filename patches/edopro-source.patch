+		evlite_reset_break();
+		stop_threads = true;
+		if(client_bev) {
+			bufferevent_free(client_bev);
+			client_bev = 0;
+		}
+		if(client_base) {
+			event_base_free(client_base);
+			client_base = 0;
+		}
