+
+/* [web] 카드 이미지를 **동기 XHR** 로 받아 MEMFS 에 저장한다.
+   (EM_ASYNC_JS 는 렌더 루프 안에서 Asyncify 중단이 실패해 호출되지 않았다 -> 동기 XHR 로 대체) */
+extern "C" int web_fetch_pic(int code, int type) {
+	return EM_ASM_INT({
+		try {
+			if(typeof Module === 'undefined' || !Module.FS) return 0;
+			var fs = Module.FS;
+			var dir = ($1 === 1) ? '/pics/field/' : (($1 === 2) ? '/pics/cover/' : '/pics/');
+			var path = dir + $0 + '.jpg';
+			try { fs.stat(path); return 1; } catch(e) {}
+			try { fs.mkdirTree(dir); } catch(e) {}
+			var xhr = new XMLHttpRequest();
+			xhr.open('GET', '/img/' + $0 + '.jpg', false);
+			xhr.overrideMimeType('text/plain; charset=x-user-defined');
+			xhr.send(null);
+			if(xhr.status !== 200) return 0;
+			var txt = xhr.responseText || '';
+			if(txt.length < 800) return 0;
+			var arr = new Uint8Array(txt.length);
+			for(var i = 0; i < txt.length; i++) arr[i] = txt.charCodeAt(i) & 0xff;
+			fs.writeFile(path, arr);
+			window.__picOk = (window.__picOk || 0) + 1;
+			if(window.__picOk <= 6) console.log('[pic] ok ' + $0 + ' ' + arr.length + 'B');
+			return 1;
+		} catch (e) { console.warn('[pic] err ' + $0 + ' ' + e); return 0; }
+	}, code, type);
+}
+
+static bool WebFetchCardImage(uint32_t code, int type) {
+	static std::set<uint32_t> done[3];
+	int idx = (type == 1) ? 1 : ((type == 2) ? 2 : 0);
+	if(done[idx].count(code))
+		return false;
+	if(web_fetch_pic((int)code, idx) != 0) {
+		done[idx].insert(code);
+		return true;
+	}
+	return false;
+}
+#endif
